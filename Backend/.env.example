# VerifyChain — Environment Variables Reference
# Copy this file to .env (backend/) and fill in your real values.
# NEVER commit .env to git. .env is in .gitignore.

# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get this from Atlas → Connect → Drivers → Node.js
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb://TulaSetu:tulasetu123@ac-ww4rhjl-shard-00-00.bksd7lm.mongodb.net:27017,ac-ww4rhjl-shard-00-01.bksd7lm.mongodb.net:27017,ac-ww4rhjl-shard-00-02.bksd7lm.mongodb.net:27017/?ssl=true&replicaSet=atlas-lzxwcp-shard-0&authSource=admin&appName=Cluster0

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=tulasetu12345678901234567890123456789012345678901234567890123456789012
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=tulasetu1234567890123456789012345678901234567890123456345678909626262
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cloudinary ────────────────────────────────────────────────────────────────
# Get these from Cloudinary Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=dv9tocgy2
CLOUDINARY_API_KEY=198599651243189
CLOUDINARY_API_SECRET=2-FqvRYNYRnDXcZ5BhiC4twIOJU

# ─── Admin Seed ────────────────────────────────────────────────────────────────
# Used ONLY by scripts/seedAdmin.js — run once at deployment setup.
# Change these to strong, real values before running the seed.
ADMIN_EMAIL=admin@verifychain.gov.in
ADMIN_PASSWORD=admin@12072006

# ─── Cookie ────────────────────────────────────────────────────────────────────
# Set to 'true' in production (requires HTTPS). Keep 'false' in local dev.
COOKIE_SECURE=false

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Frontend URL — used to restrict CORS in production.
# In dev this is typically http://localhost:5173
FRONTEND_URL=http://localhost:5173
