# VerifyChain — Frontend Environment Variables
# Copy to frontend/.env and fill in your values.
# NEVER commit .env to git.

# ─── API Base URL ──────────────────────────────────────────────────────────────
# In development, points to local backend.
# In production (Vercel), set this to your Render backend URL.
VITE_API_BASE_URL=http://localhost:5000/api/v1
